#!/bin/bash
set -euo pipefail

# setup-git — Configure git identity, SSH agent, auth key, and signing key
#
# Environment variables (set directly or via OP_*_REF convention):
#   GIT_USER_NAME        - Git user.name
#   GIT_USER_EMAIL       - Git user.email
#   GIT_AUTH_SSH_KEY     - SSH auth private key (raw PEM text)
#   GIT_SIGNING_SSH_KEY  - SSH signing private key (raw PEM text)
#
# External credential providers (#1711) — when git ssh/signing is already
# supplied from outside, the conflicting steps are skipped (one skip line
# each) instead of overriding the provider:
#   ssh     — SKIP_GIT_SSH_SETUP=true, GIT_SSH_COMMAND set, or core.sshCommand
#             in GIT_CONFIG_COUNT/GIT_CONFIG_KEY_n: no ssh-agent is started and
#             no auth key / core.sshCommand is written.
#   signing — SKIP_GIT_SIGNING_SETUP=true, or gpg.format / gpg.ssh.program /
#             user.signingkey in GIT_CONFIG_KEY_n: signing config is neither
#             written nor cleared.
# Identity (GIT_USER_NAME / GIT_USER_EMAIL) and SSH keep-alive always run.

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
_info()  { printf '[setup-git] %s\n' "$*" >&2; }
_ok()    { printf '[setup-git] OK: %s\n' "$*" >&2; }
_skip()  { printf '[setup-git] skip: %s\n' "$*" >&2; }
_warn()  { printf '[setup-git] WARN: %s\n' "$*" >&2; }

# Warn when an OP_<NAME>_REF is configured but <NAME> resolved empty. The secret
# was expected but is not here yet — typically postStartCommand racing the
# entrypoint's 45-op-secrets.sh under Zed, which fires postStart concurrently
# with the entrypoint rather than after it (VS Code's "overrideCommand": false
# makes the entrypoint PID 1, so postStart waits and this cannot happen).
#
# Without this, an unresolved secret is indistinguishable from "nothing to do":
# the callers' `[ -n "${VAR:-}" ] || return 0` guards return 0 silently, the
# postStart && chain reports success, and the container comes up with no keys.
# Always returns 0 — callers still skip; the operator just learns why.
_warn_if_ref_unresolved() {
    local name="$1" ref_var="OP_${1}_REF"
    [ -n "${!ref_var:-}" ] || return 0   # no ref configured — genuinely nothing to do
    [ -z "${!name:-}" ] || return 0      # resolved fine
    _warn "${ref_var} is set but ${name} is empty — secret not resolved yet."
    _warn "  Under Zed, postStartCommand can race the entrypoint's secret"
    _warn "  resolution. Re-run 'setup-git' once startup finishes."
}

# ---------------------------------------------------------------------------
# Input validation
# ---------------------------------------------------------------------------
_validate_email() {
    local val="$1" name="$2"
    case "$val" in
        ?*@?*) return 0 ;;
    esac
    _warn "${name} does not look like a valid email (missing user@domain) — using fallback"
    return 1
}

_validate_ssh_key() {
    local val="$1" name="$2"
    case "$val" in
        "-----BEGIN "*)  return 0 ;;
    esac
    _warn "${name} does not look like a PEM-encoded key (missing -----BEGIN header) — skipping"
    return 1
}

# ---------------------------------------------------------------------------
# Source .env.secrets + OP cache (makes scripts work without pre-sourced env)
# ---------------------------------------------------------------------------
_SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
[ -f "${_SELF_DIR}/_source-env-secrets" ] && . "${_SELF_DIR}/_source-env-secrets"
# shellcheck disable=SC1091
[ -f "${_SELF_DIR}/_wait-for-op-cache" ] && . "${_SELF_DIR}/_wait-for-op-cache"
# placeholder_reason — the placeholder-email rules shared with the pre-commit
# hook bin/check-author-identity.sh (#1533). Absent → nothing is a placeholder;
# the differs-from-global check still runs.
if [ -f "${_SELF_DIR}/_git-email-placeholder" ]; then
    # shellcheck source=lib/runtime/commands/_git-email-placeholder
    . "${_SELF_DIR}/_git-email-placeholder"
else
    placeholder_reason() { return 1; }
fi
unset _SELF_DIR

# Write key material to file only if content differs. Returns 0 if written, 1 if unchanged.
_write_key() {
    local path="$1" var_name="$2"
    # Save xtrace state and disable it to avoid leaking key material
    local _xt; _xt=$(set +o | command grep xtrace)
    { set +x; } 2>/dev/null
    local content="${!var_name}"
    if [ -f "$path" ] && [ "$(command cat "$path")" = "$content" ]; then
        # Content unchanged — still enforce permissions in case they drifted
        chmod 600 "$path"
        eval "$_xt"
        return 1
    fi
    # Restrictive umask prevents brief window of permissive default permissions
    (
        umask 077
        printf '%s\n' "$content" > "$path"
    )
    chmod 600 "$path"
    eval "$_xt"
    return 0
}

# ---------------------------------------------------------------------------
# 1. Git identity
# ---------------------------------------------------------------------------
setup_identity() {
    local changed=false

    # Apply fallback defaults so git operations never fail with missing identity.
    # These are intentionally obvious so users notice and fix their config.
    local name="${GIT_USER_NAME:-Devcontainer}"
    local email="${GIT_USER_EMAIL:-devcontainer@localhost}"

    # Validate email — fall back to default if malformed
    if [ -n "${GIT_USER_EMAIL:-}" ] && ! _validate_email "$email" "GIT_USER_EMAIL"; then
        email="devcontainer@localhost"
    fi

    local current
    current=$(git config --global user.name 2>/dev/null || true)
    if [ "$current" != "$name" ]; then
        git config --global user.name "$name"
        changed=true
    fi

    current=$(git config --global user.email 2>/dev/null || true)
    if [ "$current" != "$email" ]; then
        git config --global user.email "$email"
        changed=true
    fi

    if [ "$changed" = true ]; then
        _ok "git identity: $(git config --global user.name) <$(git config --global user.email)>"
    else
        _skip "git identity already configured"
    fi
}

# ---------------------------------------------------------------------------
# 1b. Repo-local identity shadowing (#1533) — warn only, never fix
# ---------------------------------------------------------------------------
# `git commit` prefers a repo-local .git/config identity over the global one
# set above, and that file lives in the bind-mounted workspace, so it survives
# rebuilds and re-running setup-git. A stale local `t@t.t` once shipped 31
# commits under a stranger's GitHub account while setup-git reported the real
# global identity. A per-repo work email can be deliberate, so this only warns.

# Print candidate repo dirs: WORKSPACE_ROOT, its children, and their
# .worktrees/* entries. Callers filter to real repos.
_workspace_repo_candidates() {
    local root="${WORKSPACE_ROOT:-/workspace}" d
    [ -d "$root" ] || return 0
    printf '%s\n' "${root%/}"
    for d in "${root%/}"/*/ "${root%/}"/*/.worktrees/*/; do
        [ -d "$d" ] && printf '%s\n' "${d%/}"
    done
}

# Echo $1 with control characters (incl. ANSI escapes' ESC) removed.
_printable() {
    printf '%s' "$1" | command tr -d '[:cntrl:]'
}

check_identity_shadowing() {
    local global_email reason
    global_email=$(git config --global --get user.email 2>/dev/null || true)

    if [ -n "$global_email" ] && reason=$(placeholder_reason "$global_email"); then
        _warn "global git email <${global_email}> is a placeholder (${reason})."
        _warn "  Commits will be refused by the pre-commit author-identity check"
        _warn "  until GIT_USER_EMAIL resolves (check OP_GIT_USER_EMAIL_REF)."
    fi

    local dir origin file email seen=$'\n'
    while IFS= read -r dir; do
        git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || continue
        origin=$(git -C "$dir" config --local --show-origin --get user.email 2>/dev/null) || continue
        # "file:/path/.git/config<TAB>email" — worktrees share their repo's
        # config, so report each config file once.
        file="${origin%%$'\t'*}"
        file="${file#file:}"
        # Relative to -C dir (".git/config"); absolutize for the message and
        # so a worktree's "../../.git/config" dedupes against its parent.
        case "$file" in /*) ;; *) file="${dir}/${file}" ;; esac
        file=$(command realpath -m "$file" 2>/dev/null || printf '%s' "$file")
        email="${origin#*$'\t'}"
        case "$seen" in *$'\n'"$file"$'\n'*) continue ;; esac
        seen+="${file}"$'\n'
        if [ -z "$email" ] || [ "$email" = "$global_email" ]; then
            continue
        fi

        # The email, dir and file come from the workspace (possibly a cloned,
        # untrusted repo): strip control chars so they cannot spoof terminal
        # output, and %q-quote the dir in the copy-paste remedy.
        local shown_email shown_dir shown_file qdir
        shown_email=$(_printable "$email")
        shown_dir=$(_printable "$dir")
        shown_file=$(_printable "$file")
        printf -v qdir '%q' "$dir"
        if reason=$(placeholder_reason "$email"); then
            _warn "${shown_dir}: local user.email <${shown_email}> is a placeholder (${reason}),"
        else
            _warn "${shown_dir}: local user.email <${shown_email}> differs from global <${global_email}>,"
        fi
        _warn "  set in ${shown_file} — it overrides the global identity for commits here."
        _warn "  If unintended: git -C ${qdir} config --local --unset user.name;" \
            "git -C ${qdir} config --local --unset user.email"
    done < <(_workspace_repo_candidates)
    return 0
}

# ---------------------------------------------------------------------------
# External-provider detection (#1711)
# ---------------------------------------------------------------------------
# Print the first of the given keys (case-insensitive, as git treats them)
# that the GIT_CONFIG_COUNT / GIT_CONFIG_KEY_n env config defines. Returns 1
# when none is defined or the env config is absent/malformed.
_external_git_config() {
    local count="${GIT_CONFIG_COUNT:-0}"
    case "$count" in '' | *[!0-9]*) return 1 ;; esac
    local i key want var
    for ((i = 0; i < count; i++)); do
        var="GIT_CONFIG_KEY_${i}"
        key="${!var:-}"
        key="${key,,}"
        for want in "$@"; do
            if [ "$key" = "${want,,}" ]; then
                printf '%s' "$want"
                return 0
            fi
        done
    done
    return 1
}

# Why ssh is externally provided (printed), or return 1 if it is not.
_external_ssh_reason() {
    local k
    if [ "${SKIP_GIT_SSH_SETUP:-false}" = "true" ]; then
        printf 'SKIP_GIT_SSH_SETUP=true'
        return 0
    fi
    if [ -n "${GIT_SSH_COMMAND:-}" ]; then
        printf 'GIT_SSH_COMMAND set'
        return 0
    fi
    if k=$(_external_git_config core.sshCommand); then
        printf 'GIT_CONFIG_* defines %s' "$k"
        return 0
    fi
    return 1
}

# Why signing is externally provided (printed), or return 1 if it is not.
_external_signing_reason() {
    local k
    if [ "${SKIP_GIT_SIGNING_SETUP:-false}" = "true" ]; then
        printf 'SKIP_GIT_SIGNING_SETUP=true'
        return 0
    fi
    if k=$(_external_git_config gpg.ssh.program user.signingkey gpg.format); then
        printf 'GIT_CONFIG_* defines %s' "$k"
        return 0
    fi
    return 1
}

# ---------------------------------------------------------------------------
# 2. SSH agent
# ---------------------------------------------------------------------------
ensure_ssh_agent() {
    local agent_env="${HOME}/.ssh/agent.env"
    mkdir -p "${HOME}/.ssh"
    chmod 700 "${HOME}/.ssh"

    # Always prefer our own persisted agent — ignore externally-provided
    # SSH_AUTH_SOCK (e.g. VS Code's forwarded agent) which can be cycled
    # at any time, losing our added keys.
    if [ -f "$agent_env" ]; then
        # shellcheck disable=SC1090
        source "$agent_env" >/dev/null 2>&1 || true
        if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "${SSH_AUTH_SOCK}" ]; then
            if ssh-add -l >/dev/null 2>&1 || [ $? -eq 1 ]; then
                return 0
            fi
        fi
    fi

    # Start new agent
    _info "starting ssh-agent"
    eval "$(ssh-agent -s)" >/dev/null 2>&1
    # Persist for future shells
    command cat > "$agent_env" <<EOF
SSH_AUTH_SOCK=${SSH_AUTH_SOCK}; export SSH_AUTH_SOCK;
SSH_AGENT_PID=${SSH_AGENT_PID:-}; export SSH_AGENT_PID;
EOF
    chmod 600 "$agent_env"
    _ok "ssh-agent started (PID ${SSH_AGENT_PID:-unknown})"
}

# ---------------------------------------------------------------------------
# 3. SSH keep-alive for common Git hosts
# ---------------------------------------------------------------------------
setup_ssh_keepalive() {
    local ssh_config="${HOME}/.ssh/config"
    mkdir -p "${HOME}/.ssh"

    # Skip if keep-alive is already configured for github.com
    if [ -f "$ssh_config" ] && command grep -q 'Host github.com' "$ssh_config" 2>/dev/null; then
        if command grep -A5 'Host github.com' "$ssh_config" | command grep -q 'ServerAliveInterval' 2>/dev/null; then
            _skip "SSH keep-alive already configured"
            return 0
        fi
    fi

    command cat >> "$ssh_config" <<'SSHEOF'

# Keep-alive for Git hosting providers (prevents timeout on long pushes)
Host github.com gitlab.com
    ServerAliveInterval 60
    ServerAliveCountMax 10
SSHEOF
    chmod 600 "$ssh_config"
    _ok "SSH keep-alive configured for github.com and gitlab.com"
}

# ---------------------------------------------------------------------------
# 4. Auth SSH key
# ---------------------------------------------------------------------------
setup_auth_key() {
    _warn_if_ref_unresolved GIT_AUTH_SSH_KEY
    [ -n "${GIT_AUTH_SSH_KEY:-}" ] || return 0
    _validate_ssh_key "$GIT_AUTH_SSH_KEY" "GIT_AUTH_SSH_KEY" || return 0

    local key_path="${HOME}/.ssh/git_auth_key"

    if _write_key "$key_path" GIT_AUTH_SSH_KEY; then
        _ok "wrote auth key to ${key_path}"
    else
        _skip "auth key unchanged"
    fi

    # Add to agent if not already present
    local key_fp
    key_fp=$(ssh-keygen -lf "$key_path" 2>/dev/null | awk '{print $2}') || true
    if [ -n "$key_fp" ]; then
        if ! ssh-add -l 2>/dev/null | command grep -qF "$key_fp"; then
            # Best-effort: core.sshCommand below does not need the agent, so a
            # failed add (dead socket, refused key) must not abort under set -e.
            if ssh-add "$key_path" 2>/dev/null; then
                _ok "auth key added to ssh-agent"
            else
                _warn "could not add auth key to ssh-agent (agent unreachable or key refused); continuing"
            fi
        else
            _skip "auth key already in ssh-agent"
        fi
    fi

    # Set core.sshCommand so VS Code's git extension (which does not inherit
    # the terminal SSH agent) uses the provisioned key directly.
    git config --global core.sshCommand "ssh -i ${key_path} -o IdentitiesOnly=yes"
    _ok "core.sshCommand configured for VS Code compatibility"
}

# ---------------------------------------------------------------------------
# 5. Signing SSH key
# ---------------------------------------------------------------------------

# Clear any stale signing configuration from .gitconfig
_clear_signing_config() {
    local had_config=false
    if git config --global --get user.signingkey >/dev/null 2>&1; then
        had_config=true
    fi
    git config --global --unset gpg.format 2>/dev/null || true
    git config --global --unset user.signingkey 2>/dev/null || true
    git config --global --unset commit.gpgsign 2>/dev/null || true
    git config --global --unset tag.gpgsign 2>/dev/null || true
    git config --global --unset gpg.ssh.allowedSignersFile 2>/dev/null || true
    if [ "$had_config" = true ]; then
        _info "cleared stale signing configuration from .gitconfig"
    fi
}

# Configure git signing using a public key string
_configure_signing() {
    local pubkey="$1"
    local pub="${HOME}/.ssh/git_signing_key.pub"
    local signers="${HOME}/.ssh/allowed_signers"

    printf '%s\n' "$pubkey" > "$pub"
    chmod 644 "$pub"

    local email
    email=$(git config --global user.email 2>/dev/null || echo "user@container")

    git config --global gpg.format ssh
    git config --global user.signingkey "$pub"
    git config --global commit.gpgsign true
    git config --global tag.gpgsign true

    printf '%s %s\n' "$email" "$pubkey" > "$signers"
    chmod 644 "$signers"
    git config --global gpg.ssh.allowedSignersFile "$signers"
}

setup_signing_key() {
    _warn_if_ref_unresolved GIT_SIGNING_SSH_KEY

    # --- Path A: explicit key via environment variable ---
    if [ -n "${GIT_SIGNING_SSH_KEY:-}" ]; then
        _validate_ssh_key "$GIT_SIGNING_SSH_KEY" "GIT_SIGNING_SSH_KEY" || return 0

        local priv="${HOME}/.ssh/git_signing_key"

        if _write_key "$priv" GIT_SIGNING_SSH_KEY; then
            _ok "wrote signing key to ${priv}"
        else
            _skip "signing key unchanged"
        fi

        # Derive public key from private key
        local pubkey
        pubkey=$(ssh-keygen -y -f "$priv" 2>/dev/null) || {
            _warn "could not derive public key from signing key"
            return 0
        }

        _configure_signing "$pubkey"
        _ok "git signing configured (gpg.format=ssh, source=env)"

        # Add to agent if not already present
        local key_fp
        key_fp=$(ssh-keygen -lf "$priv" 2>/dev/null | awk '{print $2}') || true
        if [ -n "$key_fp" ]; then
            if ! ssh-add -l 2>/dev/null | command grep -qF "$key_fp"; then
                # Best-effort: signing is already configured above from the
                # key file; a failed agent add must not abort under set -e.
                if ssh-add "$priv" 2>/dev/null; then
                    _ok "signing key added to ssh-agent"
                else
                    _warn "could not add signing key to ssh-agent (agent unreachable or key refused); continuing"
                fi
            else
                _skip "signing key already in ssh-agent"
            fi
        fi
        return 0
    fi

    # --- Path B: detect key from SSH agent ---
    local agent_keys
    agent_keys=$(ssh-add -L 2>/dev/null) || true
    if [ -n "$agent_keys" ]; then
        local key_count
        key_count=$(printf '%s\n' "$agent_keys" | command wc -l | command tr -d ' ')
        if [ "$key_count" -gt 1 ]; then
            _info "SSH agent has ${key_count} keys; using first key for signing"
        fi
        local first_key
        first_key=$(printf '%s\n' "$agent_keys" | command head -1)

        _configure_signing "$first_key"
        _ok "git signing configured (gpg.format=ssh, source=agent)"
        return 0
    fi

    # --- Path C: no signing key available — clear stale config ---
    _clear_signing_config
    _skip "no signing key (set GIT_SIGNING_SSH_KEY or forward SSH agent)"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
    _info "configuring git environment"
    setup_identity
    check_identity_shadowing || true

    local reason
    if reason=$(_external_ssh_reason); then
        _skip "ssh agent + auth key: provided externally (${reason})"
        setup_ssh_keepalive
    else
        ensure_ssh_agent
        setup_ssh_keepalive
        setup_auth_key
    fi

    if reason=$(_external_signing_reason); then
        _skip "signing: provided externally (${reason})"
    else
        setup_signing_key
    fi
    _ok "done"
}

main "$@"
