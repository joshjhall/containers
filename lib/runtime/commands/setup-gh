#!/bin/bash
set -euo pipefail

# setup-gh — Authenticate GitHub CLI
#
# Environment variables (set directly or via OP_*_REF convention):
#   GITHUB_TOKEN        - GitHub personal access token
#   FORGE_TOKEN_EXPORT  - true|false|auto (default auto). Whether shells get
#                         GITHUB_TOKEN copied from `gh auth token` (#1711).
#                         auto: only when gh holds its own stored token
#                         (hosts.yml, i.e. this script's login flow). A gh
#                         authenticated some other way (e.g. an external
#                         credential provider's shim) is left alone so its
#                         token is never copied into every process's env.

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
_info()  { printf '[setup-gh] %s\n' "$*" >&2; }
_ok()    { printf '[setup-gh] OK: %s\n' "$*" >&2; }
_skip()  { printf '[setup-gh] skip: %s\n' "$*" >&2; }
_warn()  { printf '[setup-gh] WARN: %s\n' "$*" >&2; }

# ---------------------------------------------------------------------------
# Input validation
# ---------------------------------------------------------------------------
_validate_token() {
    local val="$1" name="$2"
    # Must be at least 4 characters
    if [ "${#val}" -lt 4 ]; then
        _warn "${name} is too short (less than 4 characters) — skipping"
        return 1
    fi
    # Must contain only printable ASCII (no control chars, no newlines)
    case "$val" in
        *[[:cntrl:]]*)
            _warn "${name} contains control characters — skipping"
            return 1 ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------
# Source .env.secrets + OP cache (makes scripts work without pre-sourced env)
# ---------------------------------------------------------------------------
_SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
[ -f "${_SELF_DIR}/_source-env-secrets" ] && . "${_SELF_DIR}/_source-env-secrets"
# shellcheck disable=SC1091
[ -f "${_SELF_DIR}/_wait-for-op-cache" ] && . "${_SELF_DIR}/_wait-for-op-cache"
unset _SELF_DIR

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
    # gh not installed — nothing to do
    if ! command -v gh >/dev/null 2>&1; then
        _skip "gh CLI not installed"
        return 0
    fi

    # Disable xtrace from here through the login: every line below may expand
    # the token (the already-authenticated export, the emptiness check,
    # sanitize, validate). Each return in this region restores it first (#1468).
    local _xt; _xt=$(set +o | command grep xtrace)
    { set +x; } 2>/dev/null

    # Already authenticated — decide whether shells should get GITHUB_TOKEN
    if gh auth status >/dev/null 2>&1; then
        _skip "gh already authenticated"
        # Test the token while xtrace is still off — expanding it under -x
        # is exactly the leak #1468 closed.
        local _have_token=false
        [ -n "${GITHUB_TOKEN:-}" ] && _have_token=true
        eval "$_xt"
        if [ "$_have_token" = false ] && ! _should_export_token; then
            _skip "not exporting GITHUB_TOKEN: gh authenticates without a stored token (set FORGE_TOKEN_EXPORT=true to force)"
        fi
        _persist_token
        return 0
    fi

    # No token — print help and exit (not an error)
    if [ -z "${GITHUB_TOKEN:-}" ]; then
        eval "$_xt"
        _info "GITHUB_TOKEN not set — skipping gh authentication"
        _info "Set GITHUB_TOKEN directly or via OP_GITHUB_TOKEN_REF"
        return 0
    fi

    # Sanitize token (strip whitespace)
    local token
    token=$(printf '%s' "$GITHUB_TOKEN" | tr -d '[:space:]')

    # Validate token format
    _validate_token "$token" "GITHUB_TOKEN" || { eval "$_xt"; return 0; }

    # Authenticate (pipe token via stdin to avoid exposing it in process listings).
    # gh refuses `auth login` while GITHUB_TOKEN or GH_TOKEN is set in its env,
    # so clear both for the login only (#1457).
    _info "authenticating gh CLI"
    local rc=0
    printf '%s' "$token" | command env -u GITHUB_TOKEN -u GH_TOKEN gh auth login --with-token 2>&1 || rc=$?
    eval "$_xt"
    if [ "$rc" -ne 0 ]; then
        _warn "gh auth login failed (exit ${rc}) — GITHUB_TOKEN may be invalid or expired, or github.com unreachable"
        return "$rc"
    fi

    # Persist token derivation in bashrc
    _persist_token

    # Verify
    if gh auth status >/dev/null 2>&1; then
        _ok "gh authenticated"
    else
        _info "gh authentication could not be verified"
    fi
}

# Whether shells should get GITHUB_TOKEN copied out of gh (#1711).
# Mirrors the condition in the persisted bashrc snippet below.
_gh_hosts_file() {
    printf '%s/hosts.yml' "${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gh}"
}
_should_export_token() {
    case "${FORGE_TOKEN_EXPORT:-auto}" in
        true) return 0 ;;
        false) return 1 ;;
    esac
    command grep -qs 'oauth_token:' "$(_gh_hosts_file)"
}

# The pre-#1711 snippet, removed verbatim on upgrade so a persisted $HOME stops
# exporting a provider's token. Matched exactly; a hand-edited block is left
# alone (it no longer carries the marker below, so the new one is added too).
_LEGACY_SNIPPET='# setup-gh: GITHUB_TOKEN
if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    export GITHUB_TOKEN=$(gh auth token 2>/dev/null | tr -d '"'"'[:space:]'"'"')
fi'

_persist_token() {
    local rc="${HOME}/.bashrc"
    local marker="# setup-gh: GITHUB_TOKEN (v2"
    _remove_legacy_snippet "$rc"
    if ! command grep -qF "$marker" "$rc" 2>/dev/null; then
        command cat >> "$rc" <<'BASHRC'

# setup-gh: GITHUB_TOKEN (v2, #1711; FORGE_TOKEN_EXPORT=true|false|auto)
if [ -z "${GITHUB_TOKEN:-}" ] && [ "${FORGE_TOKEN_EXPORT:-auto}" != "false" ] && command -v gh >/dev/null 2>&1; then
    if [ "${FORGE_TOKEN_EXPORT:-auto}" = "true" ] || command grep -qs 'oauth_token:' "${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gh}/hosts.yml"; then
        gh auth status >/dev/null 2>&1 && export GITHUB_TOKEN=$(gh auth token 2>/dev/null | tr -d '[:space:]')
    fi
fi
BASHRC
    fi
}

# Remove the exact legacy block from $1 via the shared rc-snippet helper
# (#1721): the source-tree sibling, then the installed copy. An older image
# without the helper degrades to a no-op. RC_SNIPPET_LIB overrides the path
# ONLY under TEST_MODE=1 (exported by tests/framework.sh) — the helper is
# sourced in a process holding the forge token, so production runs never
# load code from an env-named path (#1749).
_remove_legacy_snippet() {
    local lib="" cand
    if [ "${TEST_MODE:-}" = "1" ]; then lib="${RC_SNIPPET_LIB:-}"; fi
    if [ -z "$lib" ]; then
        for cand in "$(command dirname "${BASH_SOURCE[0]}")/../lib/rc-snippet.sh" \
                    /opt/container-runtime/lib/rc-snippet.sh; do
            if [ -f "$cand" ]; then lib="$cand"; break; fi
        done
    fi
    [ -n "$lib" ] && [ -f "$lib" ] || return 0
    # shellcheck source=/dev/null
    . "$lib"
    local st=0
    rc_remove_block "$1" "$_LEGACY_SNIPPET" || st=$?
    case "$st" in
        0) _info "removed pre-#1711 token snippet from $1" ;;
        2) _warn "could not rewrite $1 while removing the pre-#1711 token snippet; its full edited content is saved at ${RC_REMOVE_BLOCK_KEPT} — restore it with: cp '${RC_REMOVE_BLOCK_KEPT}' '$1'" ;;
    esac
    return 0
}

main "$@"
