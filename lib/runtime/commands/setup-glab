#!/bin/bash
set -euo pipefail

# setup-glab — Authenticate GitLab CLI
#
# Environment variables (set directly or via OP_*_REF convention):
#   GITLAB_TOKEN  - GitLab personal access token
#   GITLAB_HOST   - GitLab hostname (default: gitlab.com)
#   FORGE_TOKEN_EXPORT - true|false|auto (default auto). Whether shells get
#                   GITLAB_TOKEN copied from glab's config (#1711). auto: only
#                   when glab holds its own stored token (config.yml, i.e. this
#                   script's login flow). A glab authenticated some other way
#                   (e.g. an external credential provider's shim) is left
#                   alone so its token is never copied into every process's env.

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
_info()  { printf '[setup-glab] %s\n' "$*" >&2; }
_ok()    { printf '[setup-glab] OK: %s\n' "$*" >&2; }
_skip()  { printf '[setup-glab] skip: %s\n' "$*" >&2; }
_warn()  { printf '[setup-glab] WARN: %s\n' "$*" >&2; }

# ---------------------------------------------------------------------------
# Input validation
# ---------------------------------------------------------------------------
_validate_token() {
    local val="$1" name="$2"
    # Must be at least 4 characters
    if [ "${#val}" -lt 4 ]; then
        _warn "${name} is too short (less than 4 characters) — skipping"
        return 1
    fi
    # Must contain only printable ASCII (no control chars, no newlines)
    case "$val" in
        *[[:cntrl:]]*)
            _warn "${name} contains control characters — skipping"
            return 1 ;;
    esac
    return 0
}

_validate_hostname() {
    local val="$1" name="$2"
    # Must be non-empty, contain only alphanumeric, dots, hyphens, and optional port
    case "$val" in
        *[[:space:]]* | */* | "")
            _warn "${name} does not look like a valid hostname — skipping"
            return 1 ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------
# Source .env.secrets + OP cache (makes scripts work without pre-sourced env)
# ---------------------------------------------------------------------------
_SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
[ -f "${_SELF_DIR}/_source-env-secrets" ] && . "${_SELF_DIR}/_source-env-secrets"
# shellcheck disable=SC1091
[ -f "${_SELF_DIR}/_wait-for-op-cache" ] && . "${_SELF_DIR}/_wait-for-op-cache"
unset _SELF_DIR

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
    # glab not installed — nothing to do
    if ! command -v glab >/dev/null 2>&1; then
        _skip "glab CLI not installed"
        return 0
    fi

    local host="${GITLAB_HOST:-gitlab.com}"

    # Validate hostname
    _validate_hostname "$host" "GITLAB_HOST" || return 0

    # Disable xtrace from here through the login: every line below may expand
    # the token (the already-authenticated export, the emptiness check,
    # sanitize, validate). Each return in this region restores it first (#1468).
    local _xt; _xt=$(set +o | command grep xtrace)
    { set +x; } 2>/dev/null

    # Already authenticated — export token and exit
    if glab auth status --hostname "$host" >/dev/null 2>&1; then
        _skip "glab already authenticated (host: ${host})"
        # Test the token while xtrace is still off (#1468).
        local _have_token=false
        [ -n "${GITLAB_TOKEN:-}" ] && _have_token=true
        eval "$_xt"
        if [ "$_have_token" = false ] && ! _should_export_token; then
            _skip "not exporting GITLAB_TOKEN: glab authenticates without a stored token (set FORGE_TOKEN_EXPORT=true to force)"
        fi
        _persist_token
        return 0
    fi

    # No token — print help and exit (not an error)
    if [ -z "${GITLAB_TOKEN:-}" ]; then
        eval "$_xt"
        _info "GITLAB_TOKEN not set — skipping glab authentication"
        _info "Set GITLAB_TOKEN directly or via OP_GITLAB_TOKEN_REF"
        return 0
    fi

    # Sanitize token (strip whitespace)
    local token
    token=$(printf '%s' "$GITLAB_TOKEN" | tr -d '[:space:]')

    # Validate token format
    _validate_token "$token" "GITLAB_TOKEN" || { eval "$_xt"; return 0; }

    # Authenticate (pipe token via stdin to avoid exposing it in process listings)
    _info "authenticating glab CLI (host: ${host})"
    local rc=0
    printf '%s' "$token" | glab auth login --hostname "$host" --stdin 2>&1 || rc=$?
    eval "$_xt"
    if [ "$rc" -ne 0 ]; then
        _warn "glab auth login failed (exit ${rc}) — GITLAB_TOKEN may be invalid or expired, ${host} unreachable, or GITLAB_HOST wrong"
        return "$rc"
    fi

    # Persist token derivation in bashrc
    _persist_token

    # Verify
    if glab auth status --hostname "$host" >/dev/null 2>&1; then
        _ok "glab authenticated (host: ${host})"
    else
        _info "glab authentication could not be verified"
    fi
}

# Whether shells should get GITLAB_TOKEN copied out of glab (#1711).
# Mirrors the condition in the persisted bashrc snippet below.
_glab_config_file() {
    printf '%s/config.yml' "${GLAB_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/glab-cli}"
}
_should_export_token() {
    case "${FORGE_TOKEN_EXPORT:-auto}" in
        true) return 0 ;;
        false) return 1 ;;
    esac
    command grep -qsE '^[[:space:]]*token:[[:space:]]*[^[:space:]]' "$(_glab_config_file)"
}

# The pre-#1711 snippet, removed verbatim on upgrade (see setup-gh).
_LEGACY_SNIPPET='# setup-glab: GITLAB_TOKEN
if [ -z "${GITLAB_TOKEN:-}" ] && command -v glab >/dev/null 2>&1 && glab auth status >/dev/null 2>&1; then
    export GITLAB_TOKEN=$(glab config get token --host "${GITLAB_HOST:-gitlab.com}" 2>/dev/null | tr -d '"'"'[:space:]'"'"')
fi'

_persist_token() {
    local rc="${HOME}/.bashrc"
    local marker="# setup-glab: GITLAB_TOKEN (v2"
    _remove_legacy_snippet "$rc"
    if ! command grep -qF "$marker" "$rc" 2>/dev/null; then
        command cat >> "$rc" <<'BASHRC'

# setup-glab: GITLAB_TOKEN (v2, #1711; FORGE_TOKEN_EXPORT=true|false|auto)
if [ -z "${GITLAB_TOKEN:-}" ] && [ "${FORGE_TOKEN_EXPORT:-auto}" != "false" ] && command -v glab >/dev/null 2>&1; then
    if [ "${FORGE_TOKEN_EXPORT:-auto}" = "true" ] || command grep -qsE '^[[:space:]]*token:[[:space:]]*[^[:space:]]' "${GLAB_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/glab-cli}/config.yml"; then
        glab auth status >/dev/null 2>&1 && export GITLAB_TOKEN=$(glab config get token --host "${GITLAB_HOST:-gitlab.com}" 2>/dev/null | tr -d '[:space:]')
    fi
fi
BASHRC
    fi
}

# Remove the exact legacy block from $1 via the shared rc-snippet helper
# (#1721). RC_SNIPPET_LIB, when set, is the only path tried (tests point it at
# a missing file); otherwise the source-tree sibling, then the installed copy.
# An older image without the helper degrades to a no-op.
_remove_legacy_snippet() {
    local lib="${RC_SNIPPET_LIB:-}" cand
    if [ -z "$lib" ]; then
        for cand in "$(command dirname "${BASH_SOURCE[0]}")/../lib/rc-snippet.sh" \
                    /opt/container-runtime/lib/rc-snippet.sh; do
            if [ -f "$cand" ]; then lib="$cand"; break; fi
        done
    fi
    [ -n "$lib" ] && [ -f "$lib" ] || return 0
    # shellcheck source=/dev/null
    . "$lib"
    if rc_remove_block "$1" "$_LEGACY_SNIPPET"; then
        _info "removed pre-#1711 token snippet from $1"
    fi
    return 0
}

main "$@"
