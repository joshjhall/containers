# syntax=docker/dockerfile:1.7
# Fixture for luggage build-dep removal on rpm hosts (issue #1632).
#
# luggage removes `purpose: build` packages with `rpm -e`, never
# `dnf remove -y`, so a build dep another installed package still requires is
# REFUSED ("Failed dependencies") rather than cascading its dependents away
# (installer/sysremove.rs remove_argv). This fixture runs the real removal on
# UBI 9 minimal — the evidence base image's distro, which ships microdnf and
# no dnf — in one of two modes:
#
#   MODE=happy   node's tarball method gains make + patch as `purpose: build`;
#                both must be gone after the install, node must still run.
#   MODE=refuse  it gains `zip` (default purpose) + unzip as `purpose: build`.
#                zip requires unzip, so rpm must refuse, luggage must fail
#                loudly, and BOTH must still be installed. The failing
#                install's exit code, stderr and report are recorded under
#                /var/log/luggage and the build step exits 0, so the test can
#                inspect what was left behind.
#
# The catalog edits are applied by patch-catalog.sh to a copy of the vendored
# catalog — the snapshot itself is never modified.
#
# Build context is the repo root (`BUILD_CONTEXT=$CONTAINERS_DIR`), so every
# COPY here is repo-root-relative.

ARG NODE_VERSION=26.13.0
ARG MODE=happy

# ─── Stage 1: compile a static (musl) luggage ───
# Static so the same binary runs on UBI here and debian in the apt fixture.
FROM rust:1.99-alpine AS builder

RUN apk add --no-cache musl-dev

WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

# The cache id is a build arg so a mutation check built from a scratch copy
# (#1632) never shares a target dir with — and leaves a stale mutant binary
# behind for — the normal fixture builds.
ARG LUGGAGE_TARGET_CACHE=luggage-build-deps-target
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,id=${LUGGAGE_TARGET_CACHE},target=/workspace/target-musl \
    CARGO_TARGET_DIR=/workspace/target-musl \
    cargo build --release -p luggage --bin luggage \
    && cp target-musl/release/luggage /tmp/luggage

# ─── Stage 2: patch a copy of the catalog ───
FROM alpine:3.24 AS catalog

ARG NODE_VERSION
ARG MODE

RUN apk add --no-cache bash jq

COPY crates/luggage/testdata/catalog /catalog
COPY tests/integration/builds/luggage_build_deps/catalog-overlay /overlay
COPY tests/integration/builds/luggage_build_deps/patch-catalog.sh /patch-catalog.sh

RUN case "$MODE" in \
        happy) m=happy ;; \
        refuse) m=refuse-rhel ;; \
        *) echo "MODE must be happy or refuse, got '$MODE'" >&2; exit 1 ;; \
    esac \
    && bash /patch-catalog.sh "$m" /catalog /overlay "$NODE_VERSION"

# ─── Stage 3: install node via luggage on a fresh UBI 9 minimal ───
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.9 AS runtime

ARG NODE_VERSION
ARG MODE

# The evidence base image's preinstalled set (base-images/rhel/9):
# ca-certificates, plus shadow-utils for useradd. None of make, patch, zip,
# unzip is in ubi-minimal (verified 2026-11-16), so luggage installs — and
# owns the removal of — every build dep it declares.
RUN microdnf install -y ca-certificates shadow-utils \
    && microdnf clean all \
    && rm -rf /var/cache/yum /var/cache/dnf

RUN useradd --create-home --shell /bin/bash vscode \
    && mkdir -p /cache /var/log/luggage \
    && chown vscode:vscode /cache /var/log/luggage
ENV USERNAME=vscode

COPY --from=builder /tmp/luggage /usr/local/bin/luggage
COPY --from=catalog /catalog /opt/containers-db

# happy: the install must succeed, so a failure fails the build.
# refuse: the install must fail; record how, and let the test judge it.
SHELL ["/bin/bash", "-uo", "pipefail", "-c"]
RUN /usr/local/bin/luggage install "node@${NODE_VERSION}" \
        --catalog /opt/containers-db \
        --user vscode \
        --cache-root /cache \
        --log-dir /var/log/luggage \
        --json-report /var/log/luggage/node-report.json \
        2> /var/log/luggage/install.stderr; \
    rc=$?; \
    cat /var/log/luggage/install.stderr >&2; \
    echo "$rc" > /var/log/luggage/install.rc; \
    if [ "$MODE" = refuse ]; then exit 0; fi; \
    exit "$rc"

USER vscode
WORKDIR /home/vscode
CMD ["bash"]
