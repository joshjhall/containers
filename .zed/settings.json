{
  // Format YAML/JSON with dprint on save (matches CI + .vscode/settings.json).
  // Without these per-language formatter overrides Zed falls back to its
  // built-in formatter, which reindents YAML to 4 spaces. dprint enforces the
  // 2-space indent from dprint.json's pretty_yaml plugin.
  //
  // NOTE: deliberately no `lsp.dprint.binary.path` override here. The binary
  // lives at /usr/local/bin/dprint inside the container but at a different
  // path on a host (Homebrew: /opt/homebrew/bin/dprint), so pinning it in
  // committed repo settings makes the LSP fail to spawn every time the repo is
  // opened locally. The container-side override is written to
  // ~/.config/zed/settings.json by:
  //   lib/features/lib/dev-tools/zed-lsp-config-first-startup.sh
  // On a host, the Zed dprint extension resolves its own binary.
  "format_on_save": "on",
  "languages": {
    "YAML": {
      "formatter": { "language_server": { "name": "dprint" } }
    },
    "JSON": {
      "formatter": { "language_server": { "name": "dprint" } }
    },
    "JSONC": {
      "formatter": { "language_server": { "name": "dprint" } }
    }
  }
}
