      "name": "node-source",
      "method_kind": "source-build",
      "platform": {
        "os": "alpine",
        "arch": [
          "amd64",
          "arm64"
        ]
      },
      "source_url_template": "https://nodejs.org/dist/v{version}/node-v{version}.tar.xz",
      "strip_components": 1,
      "prefix": "/usr/local",
      "build_steps": [
        {
          "command": "./configure",
          "args": [
            "--prefix=/usr/local"
          ]
        },
        {
          "command": "make",
          "args": [
            "-j{nproc}"
          ]
        },
        {
          "command": "make",
          "args": [
            "install"
          ]
        }
      ],
      "dependencies": [
        {
          "tool": "ca_certificates"
        },
        {
          "tool": "gxx",
          "purpose": "build"
        },
        {
          "tool": "make",
          "purpose": "build"
        },
        {
          "tool": "linux_headers",
          "purpose": "build"
        },
        {
          "tool": "python3",
          "purpose": "build"
        },
        {
          "tool": "libstdcxx",
          "purpose": "runtime"
        },
        {
          "tool": "libgcc",
          "purpose": "runtime"
        }
      ],
      "verification": {
        "algorithm": "sha256",
        "checksum_manifest": true,
        "checksum_url_template": "https://nodejs.org/dist/v{version}/SHASUMS256.txt",
        "tier": 3
      }
    }
