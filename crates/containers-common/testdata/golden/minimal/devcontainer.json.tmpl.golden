{
  "name": "myapp",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace/myapp",
  "overrideCommand": false,
  "postCreateCommand": "echo 'Container created'",
  // recover-entrypoint replays the image ENTRYPOINT under devcontainer impls
  // that ignore `"overrideCommand": false` (notably Zed 0.231.1+). No-op
  // under VS Code, where the entrypoint already ran as PID 1. Keep it as
  // the first link of any project postStartCommand chain.
  "postStartCommand": "recover-entrypoint && echo 'Container started'",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "args": ["-l"]
          }
        }
      }
    }
  },
  "remoteUser": "developer",
  // Keep the image-native UID/GID (1000:1000). Left at its default (true),
  // Zed remaps the user to the host UID (501 on macOS), which breaks anything
  // that assumes the build-time owner. Rootless Podman: map the host user
  // onto 1000 with `userns_mode: "keep-id:uid=1000,gid=1000"`. See
  // docs/troubleshooting/zed-devcontainer.md#uidgid-remapping.
  "updateRemoteUserUID": false
}
