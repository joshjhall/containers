{
  "name": "Containers Development",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace/${localWorkspaceFolderBasename}",

  // Use the container's ENTRYPOINT instead of VS Code's default "sleep infinity"
  // This ensures our entrypoint runs to set up Docker socket permissions, etc.
  "overrideCommand": false,

  // Don't use features in VS Code. Rather, use the container features to be consistent across environments.
  // "features": {},

  // Container environment variables
  // "containerEnv": {
  //   "SKIP_CASE_FIX": "true",   // Detect and report filesystem problems, but never repair them
  //   "SKIP_CASE_CHECK": "true"  // Disable the workspace filesystem health check entirely
  // },

  // Lifecycle hooks (same layout as the sibling librarian repo):
  // - post-create.sh (once): lefthook hooks, .env checks, recommended tools,
  //   and a loud warning when the image is stale vs docker-compose.yml.
  // - post-start.sh (every start): recover-entrypoint, setup-git, setup-gh.
  //   `recover-entrypoint` is a no-op under VS Code (entrypoint already ran as
  //   PID 1) and replays the image ENTRYPOINT under Zed (which ignores
  //   `"overrideCommand": false`). See docs/troubleshooting/zed-devcontainer.md.
  "postCreateCommand": ["bash", ".devcontainer/post-create.sh"],
  "postStartCommand": ["bash", ".devcontainer/post-start.sh"],

  "customizations": {
    "vscode": {
      "extensions": [
        "Anthropic.claude-code",
        "bierner.markdown-mermaid",
        "dprint.dprint",
        "mohsen1.prettify-json",
        "ms-azuretools.vscode-docker",
        "ms-vscode.makefile-tools",
        "tekumara.typos-vscode",
        "usernamehw.errorlens",
        "wayou.vscode-todo-highlight"
      ],

      "settings": {
        // General editor settings
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },

        // Terminal settings
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash",
            "args": ["-l"]
          }
        }
      }
    },
    "zed": {
      "extensions": [
        "dockerfile",
        "dprint",
        "env",
        "just",
        "terraform",
        "toml"
      ]
    }
  },

  "remoteUser": "vscode",

  // Keep the image-native UID/GID instead of remapping to the host's (Zed adopts
  // the host UID, e.g. 501 on macOS). See
  // docs/troubleshooting/zed-devcontainer.md#uidgid-remapping.
  "updateRemoteUserUID": false
}
