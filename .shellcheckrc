# ShellCheck configuration for container build system
# See https://github.com/koalaman/shellcheck/wiki/Directive for details

# Severity is NOT configurable here: shellcheck reads it only from the command
# line and silently ignores a `severity=` key in this file. Every gate
# (lefthook shellcheck + actionlint hooks, justfile) passes --severity=warning,
# so info-level codes such as SC2086 (unquoted expansion) are not enforced.

# Shell dialect
shell=bash

# Only disable checks that are fundamentally incompatible with our architecture:

# SC1090/SC1091: Can't follow non-constant source paths
# We source files with dynamic paths (e.g., runtime loading of features)
# This is by design and unavoidable in our modular architecture
# (source-path=SCRIPTDIR + external-sources=true was measured in #1494: SC1091
# rows only drop 603 -> 251, so the disable stays.)

# SC2016: Expressions don't expand in single quotes
# We intentionally use single quotes when writing shell code to files or when
# nesting commands in bash -c that should expand at execution time, not build time
disable=SC1090,SC1091,SC2016

# All other checks should be fixed in the code, not disabled globally
# Use inline '# shellcheck disable=SCxxxx' only with clear justification
